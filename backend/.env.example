APP_NAME="AI Knowledge Base"
APP_VERSION=0.1.0

DEBUG=true

# LLM provider: gemini | ollama | deepseek
LLM_PROVIDER=deepseek

# Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# DeepSeek (required when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding provider: openai_compat | ollama
# openai_compat 适用于阿里云百炼、OpenAI 及各类 OpenAI 兼容向量接口
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# text-embedding-v4 可选输出维度，0 表示模型默认
EMBEDDING_DIMENSIONS=0
# 百炼等 openai_compat 接口单次最多 20 条
EMBEDDING_BATCH_SIZE=20

# ollama 向量（EMBEDDING_PROVIDER=ollama 时）
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL_OLLAMA=http://localhost:11434

# 本地开发用 localhost；docker-compose.prod 会自动覆盖为 postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ai_kb

# 本地开发用 localhost:9000；生产 compose 会覆盖为 minio:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# RAG retrieval: vector recall then rerank
RERANK_ENABLED=true
# openai_compat: 百炼 qwen3-rerank | dashscope: gte-rerank-v2 | ollama: /api/rerank
RERANK_PROVIDER=openai_compat
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=
RERANK_BASE_URL=
VECTOR_RECALL_K=20
RERANK_TOP_K=4

    # 混合检索：向量 + BM25 关键词
HYBRID_SEARCH_ENABLED=True
KEYWORD_RECALL_K= 20

# 单会话最大消息条数（用户+助手合计），超出后需新建会话
CHAT_MAX_MESSAGES=50

# 知识库文档上传：允许的扩展名（逗号分隔）、单文件大小上限（MB）
UPLOAD_ALLOWED_EXTENSIONS=pdf,txt,md,xlsx,xls
UPLOAD_MAX_SIZE_MB=20
