APP_NAME="AI Knowledge Base"
APP_VERSION=0.1.0

DEBUG=true

# ============================================================
# 大语言模型（LLM）
# ============================================================
# provider: gemini | ollama | deepseek | bailian
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=                 # 留空则用 provider 默认值
LLM_MODEL=                    # 留空则用 provider 默认值

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TOP_P=0.9

# ============================================================
# 向量模型（Embedding）
# ============================================================
# provider: openai_compat | ollama
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# openai_compat 时可选维度，0=模型默认
EMBEDDING_DIMENSIONS=0
EMBEDDING_BATCH_SIZE=20

# ============================================================
# 重排模型（Rerank）
# ============================================================
RERANK_ENABLED=true
# provider: openai_compat | dashscope | ollama
RERANK_PROVIDER=openai_compat
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=
RERANK_BASE_URL=

VECTOR_RECALL_K=20
RERANK_TOP_K=4

# 本地开发用 localhost；docker-compose.prod 会自动覆盖为 postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ai_kb

DB_POOL_SIZE=30
DB_MAX_OVERFLOW=50

# 本地开发用 localhost:9000；生产 compose 会覆盖为 minio:9000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 混合检索：向量 + BM25 关键词
HYBRID_SEARCH_ENABLED=True
KEYWORD_RECALL_K= 20

# 单会话最大消息条数（用户+助手合计），超出后需新建会话
CHAT_MAX_MESSAGES=50

# 知识库文档上传：允许的扩展名（逗号分隔）、单文件大小上限（MB）
UPLOAD_ALLOWED_EXTENSIONS=pdf,txt,md,xlsx,xls
UPLOAD_MAX_SIZE_MB=20
