APP_NAME=AI Knowledge Base
APP_VERSION=0.1.0

DEBUG=true

# LLM provider: gemini | ollama
LLM_PROVIDER=ollama

# Gemini (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama (required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ai_knowledge_base

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false

JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# RAG retrieval: vector recall then rerank
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
VECTOR_RECALL_K=20
RERANK_TOP_K=4

# 单会话最大消息条数（用户+助手合计），超出后需新建会话
CHAT_MAX_MESSAGES=50
