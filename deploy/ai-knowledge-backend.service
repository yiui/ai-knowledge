[Unit]
Description=AI Knowledge Base API (FastAPI)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=@DEPLOY_USER@
Group=@DEPLOY_USER@
WorkingDirectory=@DEPLOY_PATH@/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=@DEPLOY_PATH@/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
